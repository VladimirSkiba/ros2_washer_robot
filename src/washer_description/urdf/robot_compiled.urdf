<robot name="washer_robot">
  <!-- МАТЕРИАЛЫ -->
  <material name="white_body">
    <color rgba="0.9 0.9 0.85 1"/>
  </material>
  <material name="black_trim">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <!-- БАЗОВЫЙ КОРПУС -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.9 0.55 0.5"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.35"/>
      <material name="white_body"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.9 0.55 0.5"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.35"/>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <origin rpy="0 0 0" xyz="0 0 0.35"/>
      <inertia ixx="2.0" ixy="0.0" ixz="0.0" iyy="2.5" iyz="0.0" izz="3.0"/>
    </inertial>
  </link>
  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <cylinder length="0.08" radius="0.12"/>
      </geometry>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <material name="black_trim"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.08" radius="0.12"/>
      </geometry>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin rpy="0 0 0" xyz="-0.3 0.32 0.12"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <cylinder length="0.08" radius="0.12"/>
      </geometry>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <material name="black_trim"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.08" radius="0.12"/>
      </geometry>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin rpy="0 0 0" xyz="-0.3 -0.32 0.12"/>
    <axis xyz="0 1 0"/>
  </joint>
  <!-- ПЕРЕДНЕЕ ПОВОРОТНОЕ КОЛЕСО (КАСТЕР - СФЕРА) -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin rpy="0 0 0" xyz="0.35 0 0.06"/>
  </joint>
  <!-- ЛИДАР (КУПОЛ) -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder length="0.06" radius="0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.03"/>
      <material name="black_trim"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.06" radius="0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.03"/>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="0.1 0 0.63"/>
  </joint>
  <gazebo>
    <plugin filename="libgazebo_ros_diff_drive.so" name="diff_drive">
      <ros>
        <remapping>odom:=odom</remapping>
        <remapping>cmd_vel:=cmd_vel</remapping>
      </ros>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.56</wheel_separation>
      <wheel_diameter>0.24</wheel_diameter>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
    </plugin>
  </gazebo>
  <!-- 2. Плагин Лидара (200 градусов обзора) -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-1.745</min_angle>
            <!-- Ограничение FOV ~200 градусов -->
            <max_angle>1.745</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="lidar_plugin">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
