<?xml version="1.0"?>
<robot name="washer_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="blue"><color rgba="0.08 0.32 0.58 1"/></material>
  <material name="black"><color rgba="0.04 0.04 0.04 1"/></material>
  <material name="silver"><color rgba="0.55 0.58 0.60 1"/></material>

  <link name="base_link">
    <visual><origin xyz="0 0 0.20"/><geometry><box size="0.75 0.55 0.30"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 0.20"/><geometry><box size="0.75 0.55 0.30"/></geometry></collision>
    <inertial><origin xyz="0 0 0.20"/><mass value="18"/><inertia ixx="1.0" ixy="0" ixz="0" iyy="1.5" iyz="0" izz="2.0"/></inertial>
  </link>

  <link name="laser_frame">
    <visual><origin xyz="0 0 0.02"/><geometry><cylinder radius="0.07" length="0.05"/></geometry><material name="silver"/></visual>
    <collision><origin xyz="0 0 0.02"/><geometry><cylinder radius="0.07" length="0.05"/></geometry></collision>
    <inertial><origin xyz="0 0 0.02"/><mass value="0.15"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.00035"/></inertial>
  </link>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_frame"/><origin xyz="0.22 0 0.48"/></joint>

  <link name="rear_left_wheel"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.13" length="0.08"/></geometry><material name="black"/></visual><collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.13" length="0.08"/></geometry></collision><inertial><origin xyz="0 0 0"/><mass value="0.5"/><inertia ixx="0.0045" ixy="0" ixz="0" iyy="0.0045" iyz="0" izz="0.0085"/></inertial></link>
  <joint name="rear_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_left_wheel"/><origin xyz="-0.20 0.30 0.14"/><axis xyz="0 1 0"/><dynamics damping="0.15" friction="0.02"/></joint>
  <link name="rear_right_wheel"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.13" length="0.08"/></geometry><material name="black"/></visual><collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.13" length="0.08"/></geometry></collision><inertial><origin xyz="0 0 0"/><mass value="0.5"/><inertia ixx="0.0045" ixy="0" ixz="0" iyy="0.0045" iyz="0" izz="0.0085"/></inertial></link>
  <joint name="rear_right_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_right_wheel"/><origin xyz="-0.20 -0.30 0.14"/><axis xyz="0 1 0"/><dynamics damping="0.15" friction="0.02"/></joint>
  <link name="caster_wheel"><visual><geometry><sphere radius="0.09"/></geometry><material name="black"/></visual><collision><geometry><sphere radius="0.09"/></geometry></collision><inertial><mass value="0.3"/><inertia ixx="0.003" iyy="0.003" izz="0.003"/></inertial></link>
  <joint name="caster_wheel_joint" type="fixed"><parent link="base_link"/><child link="caster_wheel"/><origin xyz="0.27 0 0.12"/></joint>

  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="rear_left_wheel"><material>Gazebo/Black</material></gazebo>
  <gazebo reference="rear_right_wheel"><material>Gazebo/Black</material></gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.60</wheel_separation>
      <wheel_radius>0.13</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>
  <gazebo reference="laser_frame">
    <sensor name="laser" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <ray><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range></ray>
      <always_on>true</always_on><visualize>true</visualize>
    </sensor>
  </gazebo>
</robot>
