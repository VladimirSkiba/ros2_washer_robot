<robot name="washer_robot">
  <!-- МАТЕРИАЛЫ -->
  <material name="white_body">
    <color rgba="0.9 0.9 0.85 1"/>
  </material>
  <material name="black_trim">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <!-- 1. КОРНЕВОЙ ФРЕЙМ (Точка на земле) -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- ПОДНЯЛИ: теперь корпус на 0.35м над землёй -->
    <origin rpy="0 0 0" xyz="0 0 0.35"/>
  </joint>
  <!-- 2. КОРПУС (Base Link) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.9 0.55 0.5"/>
      </geometry>
      <!-- Центр бокса совпадает с base_link -->
      <origin rpy="0 0 0" xyz="0 0 0.25"/>
      <material name="white_body"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.9 0.55 0.5"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.25"/>
    </collision>
    <inertial>
      <mass value="40.0"/>
      <!-- Реалистичная масса для мойщика с баками -->
      <origin rpy="0 0 0" xyz="0 0 0.25"/>
      <!-- Правильно рассчитанные моменты инерции для 40 кг -->
      <inertia ixx="1.8" ixy="0.0" ixz="0.0" iyy="3.7" iyz="0.0" izz="3.5"/>
    </inertial>
  </link>
  <!-- 3. ЗАДНИЕ КОЛЕСА (Радиус 0.12м) -->
  <!-- Чтобы колесо касалось земли (z=0), его центр должен быть на z=0.12. -->
  <!-- base_link на z=0.4. Значит смещение колеса: 0.12 - 0.4 = -0.28 -->
  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <cylinder length="0.08" radius="0.12"/>
      </geometry>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <material name="black_trim"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.08" radius="0.12"/>
      </geometry>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin rpy="0 0 0" xyz="-0.3 0.28 -0.13"/>
    <!-- ИСПРАВЛЕНО Z -->
    <axis xyz="0 1 0"/>
  </joint>
  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <cylinder length="0.08" radius="0.12"/>
      </geometry>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <material name="black_trim"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.08" radius="0.12"/>
      </geometry>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin rpy="0 0 0" xyz="-0.3 -0.28 -0.13"/>
    <!-- ИСПРАВЛЕНО Z -->
    <axis xyz="0 1 0"/>
  </joint>
  <!-- КАСТЕР: МИНИМАЛЬНАЯ ФИЗИКА ДЛЯ УСТОЙЧИВОСТИ -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <!-- МИКРО-МАССА -->
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin rpy="0 0 0" xyz="0.35 0 -0.19"/>
  </joint>
  <!-- НУЛЕВОЕ ТРЕНИЕ -->
  <gazebo reference="caster_wheel">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <!-- 5. ЛИДАР -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder length="0.06" radius="0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.03"/>
      <material name="black_trim"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.06" radius="0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.03"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="0.1 0 0.52"/>
    <!-- На крыше -->
  </joint>
  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <!-- Плагин лидара для Gazebo Harmonic -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <!-- ВАЖНО: явно указываем топик -->
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-1.745</min_angle>
            <max_angle>1.745</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </sensor>
  </gazebo>
  <!-- Улучшаем сцепление задних колёс с полом -->
  <gazebo reference="rear_left_wheel">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>
  <!-- GAZEBO ПЛАГИНЫ -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.56</wheel_separation>
      <wheel_radius>0.12</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <max_wheel_torque>50</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <topic>joint_states</topic>
    </plugin>
  </gazebo>
</robot>
